# syntax=docker/dockerfile:1
#
# PRODUCTION — package CI-built binaries only (no npm / go rebuild).
# Used by GitHub Actions to push GHCR. Homelab pulls those images (compose.prod).
# Keep image pins in sync with Dockerfile / CI:
#   debian:bookworm-slim (fastgen + fastproxy — ships ffmpeg)
#
# Expectation: context includes executable bin/fastgen and bin/fastproxy
# (linux, CGO_ENABLED=0, same flags as local Dockerfile build stage), plus
# web/dist from the web-build job — fastgen serves the React app from files in
# the image rather than from a go:embed, so the UI is packaged here too.

# fastgen ships ffprobe for Health L2 probes.
FROM debian:bookworm-slim AS fastgen
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates ffmpeg wget \
  && rm -rf /var/lib/apt/lists/* \
  && useradd --uid 65532 --user-group --no-create-home --shell /usr/sbin/nologin nonroot
COPY bin/fastgen /fastgen
COPY web/dist/ /srv/gofast/ui/
USER nonroot:nonroot
EXPOSE 8180
ENV PORT=8180
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD ["wget", "-q", "-O", "/dev/null", "http://127.0.0.1:8180/healthz"]
ENTRYPOINT ["/fastgen"]

# fastproxy ships ffmpeg for Class B (/stable/) demux-stable encode pipes.
FROM debian:bookworm-slim AS fastproxy
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates ffmpeg wget \
  && rm -rf /var/lib/apt/lists/* \
  && useradd --uid 65532 --user-group --no-create-home --shell /usr/sbin/nologin nonroot
COPY bin/fastproxy /fastproxy
USER nonroot:nonroot
EXPOSE 8181
ENV PORT=8181
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD ["wget", "-q", "-O", "/dev/null", "http://127.0.0.1:8181/healthz"]
ENTRYPOINT ["/fastproxy"]
