# syntax=docker/dockerfile:1
#
# PRODUCTION — package CI-built binaries only (no npm / go rebuild).
# Used by GitHub Actions to push GHCR. Homelab pulls those images (compose.prod).
# Keep image pins in sync with Dockerfile / CI:
#   debian:bookworm-slim
#   gcr.io/distroless/static-debian12:nonroot
#   busybox:1.36.1-musl
#
# Expectation: context includes executable bin/fastgen and bin/fastproxy
# (linux, CGO_ENABLED=0, same flags as local Dockerfile build stage).

FROM debian:bookworm-slim AS certs
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/*

# fastgen ships ffprobe for L3 health probes.
FROM debian:bookworm-slim AS fastgen
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates ffmpeg wget \
  && rm -rf /var/lib/apt/lists/* \
  && useradd --uid 65532 --user-group --no-create-home --shell /usr/sbin/nologin nonroot
COPY bin/fastgen /fastgen
USER nonroot:nonroot
EXPOSE 8180
ENV PORT=8180
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD ["wget", "-q", "-O", "/dev/null", "http://127.0.0.1:8180/healthz"]
ENTRYPOINT ["/fastgen"]

FROM gcr.io/distroless/static-debian12:nonroot AS fastproxy
COPY --from=certs /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY bin/fastproxy /fastproxy
COPY --from=busybox:1.36.1-musl /bin/wget /wget
EXPOSE 8181
ENV PORT=8181
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD ["/wget", "-q", "-O", "/dev/null", "http://127.0.0.1:8181/healthz"]
ENTRYPOINT ["/fastproxy"]
