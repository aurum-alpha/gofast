{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "build": "vite build",
    "dev:client": "vite dev",
    "format": "prettier --check .",
    "lint": "oxlint . --type-aware --deny-warnings",
