# Non-secret Portainer stack defaults for GoFAST.
# Copy/paste into Portainer → Stack → Environment variables, or use as env file.
# Do NOT put PATs, passwords, or tokens here.

# Image tag for both services (latest tracks main; pin sha-* for rollbacks)
IMAGE_TAG=latest

# Host ports
FASTGEN_HOST_PORT=8180
FASTPROXY_HOST_PORT=8181

# Data: named volume "fastgen-data" by default.
# Uncomment for a bind mount, e.g. Unraid/TrueNAS appdata:
# FASTGEN_DATA=/mnt/user/appdata/gofast

# Enable optional fastproxy service (leave empty for gen-only)
# COMPOSE_PROFILES=proxy
COMPOSE_PROFILES=
