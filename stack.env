# Non-secret Portainer stack defaults for GoFAST.
# Copy/paste into Portainer → Stack → Environment variables, or use as env file.
# Do NOT put PATs, passwords, or tokens here.
# Deploy-varying app config follows https://12factor.net/config (see AGENTS.md).

# Image tag for both services (latest tracks main; pin build-N or sha-* for rollbacks)
# CI also tags build-<github.run_number>; check Status → Build or GET /healthz version
IMAGE_TAG=latest

# Host ports (gen/proxy). Prefer these over changing in-container PORT.
FASTGEN_HOST_PORT=8180
FASTPROXY_HOST_PORT=8181

# Optional nginx edge (COMPOSE_PROFILES must include edge) — TLS + host routing.
# EDGE_HTTP_PORT=80
# EDGE_HTTPS_PORT=443
# EDGE_TLS_DIR=/path/on/host/certs   # fullchain.pem + privkey.pem
# EDGE_CONF=/path/on/host/gofast.conf

# In-container listen (both services use PORT; set per-service in compose)
# PORT is already set in docker-compose.prod.yml (8180 gen / 8181 proxy).
#
# Public URL Jellyfin/browsers use for gen (logos, absolute links).
# Include the port unless clients hit 80/443. No trailing slash.
# FASTGEN_BASE_URL=http://192.168.1.50:8180
# FASTGEN_BASE_URL=https://gofast.example.com
# FASTGEN_DATA_DIR=/data
# FASTGEN_CONFIG=/data/config.yaml
#
# Public FASTProxy URL as reached by Jellyfin/ffmpeg, not container-only DNS.
# Set when enabling the proxy profile. Selective BEACON proxying is the default.
# FASTGEN_PROXY_BASE_URL=http://192.168.1.50:8181
# FASTGEN_PROXY_BASE_URL=https://gofast-proxy.example.com
# Optional: same public HTTPS origin on the proxy so playlist rewrite stays
# on https. Alternative: forward X-Forwarded-Proto from your TLS edge (see README).
# FASTPROXY_PUBLIC_BASE_URL=https://gofast-proxy.example.com
# Gen-side Manual L2 rewrite (compose default http://proxy:8181). Override if needed.
# FASTGEN_PROXY_INTERNAL_URL=http://proxy:8181
FASTGEN_PROXY_ALL=false
# Proxy → gen (Docker DNS). Origin lookup + telemetry push; not Jellyfin-facing.
# FASTPROXY_GEN_URL=http://gen:8180

# Optional: force logo disk cache (env wins over config.yaml when set).
# FASTGEN_CACHE_LOGOS=true

# Daily ops-report email SMTP credentials (env preferred; never commit real values).
# FASTGEN_SMTP_USERNAME=
# FASTGEN_SMTP_PASSWORD=

# Data: named volume "fastgen-data" by default.
# Uncomment for a bind mount, e.g. Unraid/TrueNAS appdata:
# FASTGEN_DATA=/mnt/user/appdata/gofast

# Compose profiles (comma-separated): proxy | edge | edge,proxy
# COMPOSE_PROFILES=proxy
# COMPOSE_PROFILES=edge
# COMPOSE_PROFILES=edge,proxy
COMPOSE_PROFILES=

# Jellyfin tuner/guide (gen-only) — see README:
#   http://HOST:${FASTGEN_HOST_PORT}/playlist.m3u
#   http://HOST:${FASTGEN_HOST_PORT}/epg.xml
# Behind edge: https://gofast.example.com/playlist.m3u and …/epg.xml
